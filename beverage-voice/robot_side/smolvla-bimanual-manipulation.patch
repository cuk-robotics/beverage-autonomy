@@ -0,0 +1,169 @@
+"""infer --tasks: load the policy and connect hardware once, then run task sentences in order.
+
+beverage-voice launches infer this way. Its docs/protocol.md defines the contract: stdin commands
+(`stop`, `task <seconds> <sentence>`) and stdout lines starting with `BEVERAGE `. The per-task loop is
+LeRobot 0.6.1's base strategy loop with three extra exits: end detector, duration and manual preemption.
+"""
+from contextlib import contextmanager
+import json
+import math
+from pathlib import Path
+import queue
+import sys
+import threading
+import time
+
+from lerobot.rollout.strategies.base import BaseStrategy
+from lerobot.rollout.strategies.core import send_next_action
+from lerobot.utils.robot_utils import precise_sleep
+
+EVENT_PREFIX = "BEVERAGE "
+
+
+def emit(event, **fields):
+    print(EVENT_PREFIX + json.dumps({"event": event, **fields}, ensure_ascii=False), flush=True)
+
+
+def parse_plan(tasks, durations):
+    """--tasks / --task-durations JSON lists -> [(sentence, seconds)]."""
+    tasks, durations = json.loads(tasks), json.loads(durations)
+    if not isinstance(tasks, list) or not tasks or any(not isinstance(t, str) or not t.strip() for t in tasks):
+        raise ValueError("--tasks must be a nonempty JSON list of task sentences.")
+    if (not isinstance(durations, list) or len(durations) != len(tasks)
+            or any(isinstance(d, bool) or not isinstance(d, (int, float)) or not math.isfinite(d) or d <= 0 for d in durations)):
+        raise ValueError("--task-durations must be a JSON list with one positive number per task.")
+    return [(t.strip(), float(d)) for t, d in zip(tasks, durations)]
+
+
+def load_detector(config_path):
+    """EpisodeEndDetector from a beverage-autonomy episode_end_detector/config.json."""
+    config_path = Path(config_path).resolve()
+    try:
+        from episode_end_detector import EpisodeEndDetector
+    except ImportError:
+        sys.path.insert(0, str(config_path.parents[1]))  # the beverage-autonomy checkout holding the package
+        from episode_end_detector import EpisodeEndDetector
+    return EpisodeEndDetector.load_config(config_path)
+
+
+def unknown_tasks(plan, dataset_root):
+    """Sentences missing from the dataset's meta/tasks.parquet; the policy never saw them."""
+    path = Path(dataset_root) / "meta" / "tasks.parquet"
+    if not path.is_file():
+        return []
+    import pandas as pd
+    known = set(pd.read_parquet(path).index)
+    return [task for task, _ in plan if task not in known]
+
+
+class TaskListStrategy(BaseStrategy):
+    """Runs a task list; a manual `task` command drops the rest of the list and runs only that sentence."""
+
+    def __init__(self, config, plan, detector=None, commands=None):
+        super().__init__(config)
+        self.plan = list(plan)
+        self.detector = detector
+        self.commands = sys.stdin if commands is None else commands
+        self._manual = queue.Queue()
+
+    def setup(self, ctx):
+        super().setup(ctx)
+        if not hasattr(self._engine, "_task"):
+            raise RuntimeError("task_list switches sentences through SyncInferenceEngine._task; use --inference.type=sync.")
+        threading.Thread(target=self._read_commands, args=(ctx.runtime.shutdown_event,), daemon=True).start()
+
+    def _read_commands(self, shutdown_event):
+        for line in self.commands:
+            command = line.strip()
+            if command == "stop":
+                shutdown_event.set()  # Same exit as Ctrl+C: teardown returns to the start pose and disconnects.
+            elif command.startswith("task "):
+                seconds, _, task = command[5:].partition(" ")
+                try:
+                    seconds = float(seconds)
+                except ValueError:
+                    seconds = 0.0
+                if task.strip() and math.isfinite(seconds) and seconds > 0:
+                    self._manual.put((task.strip(), seconds))
+                    continue
+                print(f"Ignored command: {command}", file=sys.stderr, flush=True)
+            elif command:
+                print(f"Ignored command: {command}", file=sys.stderr, flush=True)
+        shutdown_event.set()  # The parent closed stdin, so nobody can stop this session any more.
+
+    def _take_manual(self):
+        manual = None
+        while True:
+            try:
+                manual = self._manual.get_nowait()  # Keep only the latest press.
+            except queue.Empty:
+                return manual
+
+    def run(self, ctx):
+        cfg, shutdown = ctx.runtime.cfg, ctx.runtime.shutdown_event
+        plan, source, index, total = list(self.plan), "list", 0, len(self.plan)
+        outcome = "complete"
+        emit("ready")
+        while not shutdown.is_set():
+            manual = self._take_manual()
+            if manual is not None:
+                if index and cfg.return_to_initial_position and ctx.hardware.initial_position:
+                    self._return_to_initial_position(ctx.hardware)  # 3 s linear move, no collision avoidance.
+                plan, source, index, total = [manual], "manual", 0, 1
+            if not plan:
+                break
+            task, seconds = plan.pop(0)
+            index += 1
+            emit("task_start", index=index, total=total, task=task, source=source)
+            started = time.perf_counter()
+            reason = self._run_task(ctx, task, seconds)
+            emit("task_end", index=index, reason=reason, seconds=round(time.perf_counter() - started, 1))
+            if reason == "duration" and self.detector is not None:
+                outcome = "timeout"  # The arm never reached the end pose; a person decides what happens next.
+                break
+        if shutdown.is_set():
+            outcome = "stop"
+        emit("done", reason=outcome)
+
+    def _run_task(self, ctx, task, seconds):
+        cfg, robot, shutdown = ctx.runtime.cfg, ctx.hardware.robot_wrapper, ctx.runtime.shutdown_event
+        engine, interpolator = self._engine, self._interpolator
+        control_interval = interpolator.get_control_interval(cfg.fps)
+        engine._task = task  # Applied to every observation from the next tick.
+        engine.reset()  # Drop the action chunk queued for the previous sentence.
+        interpolator.reset()
+        self._cached_obs_processed = None
+        engine.resume()
+        if self.detector is not None:
+            self.detector.start_episode([task])
+        started = time.perf_counter()
+        while not shutdown.is_set():
+            loop_start = time.perf_counter()
+            if not self._manual.empty():
+                return "preempted"
+            if loop_start - started >= seconds:
+                return "duration"
+            obs = robot.get_observation()
+            if self.detector is not None:
+                state = [obs[name] for name in self.detector.names]
+                if self.detector.update(state, timestamp=loop_start)["event"] == "episode_end":
+                    return "detector"
+            obs_processed = self._process_observation_and_notify(ctx.processors, obs)
+            if self._handle_warmup(cfg.use_torch_compile, loop_start, control_interval):
+                continue
+            action = send_next_action(obs_processed, obs, ctx, interpolator)
+            self._log_telemetry(obs_processed, action, ctx.runtime)
+            if (sleep_t := control_interval - (time.perf_counter() - loop_start)) > 0:
+                precise_sleep(sleep_t)
+        return "stop"
+
+
+@contextmanager
+def task_list_strategy(official, plan, detector=None):
+    """Make lerobot_rollout build TaskListStrategy; the config keeps --strategy.type=base."""
+    original = official.create_strategy
+    official.create_strategy = lambda config: TaskListStrategy(config, plan, detector)
+    try:
+        yield
+    finally:
+        official.create_strategy = original
