+import importlib.util
+import io
+import json
+from pathlib import Path
+import queue
+import sys
+from threading import Event
+from types import SimpleNamespace as NS
+import unittest
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / "src"))
+HAS_ROLLOUT = importlib.util.find_spec("lerobot") is not None and importlib.util.find_spec("lerobot.rollout") is not None
+JOINTS = [f"{side}_{joint}.pos" for side in ("left", "right")
+          for joint in ("shoulder_pan", "shoulder_lift", "elbow_flex", "wrist_flex", "wrist_roll", "gripper")]
+TASKS = ["Pour coffee powder from the red-lidded container into the cup.", "Pour water into the cup.",
+         "Stir the mixture in the cup with the muddler."]
+
+
+class Commands:
+    """Blocking stdin stand-in; None closes it."""
+
+    def __init__(self):
+        self.lines = queue.Queue()
+
+    def __iter__(self):
+        while (line := self.lines.get()) is not None:
+            yield line + "\n"
+
+
+class Engine:
+    ready = True
+
+    def __init__(self):
+        self._task, self.tasks_seen, self.resets = "first", [], 0
+
+    def reset(self):
+        self.resets += 1
+
+    def start(self):
+        pass
+
+    def stop(self):
+        pass
+
+    def resume(self):
+        self.tasks_seen.append(self._task)
+
+    def notify_observation(self, observation):
+        pass
+
+
+class Robot:
+    def __init__(self, on_observation=None):
+        self.pose = {joint: 0.0 for joint in JOINTS}
+        self.sent, self.reads, self.on_observation = [], 0, on_observation
+
+    def get_observation(self):
+        self.reads += 1
+        if self.on_observation:
+            self.on_observation(self.reads)
+        return dict(self.pose)
+
+    def send_action(self, action):
+        self.sent.append(action)
+        self.pose.update(action)
+        return action
+
+
+class Detector:
+    """Ends a task after `ticks` updates; ticks=None never ends."""
+
+    names = JOINTS
+
+    def __init__(self, ticks):
+        self.ticks, self.count = ticks, 0
+
+    def start_episode(self, instructions):
+        self.count = 0
+
+    def update(self, state, timestamp=None):
+        assert len(state) == 12
+        self.count += 1
+        return {"event": "episode_end" if self.ticks and self.count >= self.ticks else None}
+
+
+@unittest.skipUnless(HAS_ROLLOUT, "needs lerobot 0.6.1 rollout")
+class TaskListTests(unittest.TestCase):
+    def setUp(self):
+        from cuk_robotics.teleoperation import task_list
+        self.module = task_list
+        self.sent_tasks = []
+        original = task_list.send_next_action
+        task_list.send_next_action = lambda obs_processed, obs, ctx, interpolator: self.sent_tasks.append(ctx.policy.inference._task)
+        self.addCleanup(setattr, task_list, "send_next_action", original)
+
+    def run_strategy(self, plan, detector=None, robot=None, before=(), return_home=True):
+        commands, engine, robot = Commands(), Engine(), robot or Robot()
+        for line in before:
+            commands.lines.put(line)
+        ctx = NS(
+            runtime=NS(cfg=NS(fps=200, interpolation_multiplier=1, use_torch_compile=False, display_data=False,
+                              return_to_initial_position=return_home), shutdown_event=Event()),
+            policy=NS(inference=engine), processors=NS(robot_observation_processor=lambda obs: obs),
+            hardware=NS(robot_wrapper=robot, initial_position={joint: 1.0 for joint in JOINTS}),
+        )
+        strategy = self.module.TaskListStrategy(NS(), plan, detector, commands)
+        self.commands = commands
+        out = io.StringIO()
+        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(io.StringIO()):
+            strategy.setup(ctx)
+            strategy.run(ctx)
+        commands.lines.put(None)
+        events = [json.loads(line[len("BEVERAGE "):]) for line in out.getvalue().splitlines() if line.startswith("BEVERAGE ")]
+        return events, engine, robot
+
+    def test_detector_moves_through_the_list_with_one_engine(self):
+        events, engine, _ = self.run_strategy([(task, 30.0) for task in TASKS], Detector(ticks=3))
+        self.assertEqual([e["event"] for e in events], ["ready"] + ["task_start", "task_end"] * 3 + ["done"])
+        self.assertEqual([e["reason"] for e in events if e["event"] == "task_end"], ["detector"] * 3)
+        self.assertEqual(events[-1]["reason"], "complete")
+        self.assertEqual(engine.tasks_seen, TASKS)
+        self.assertEqual(self.sent_tasks, [TASKS[0]] * 2 + [TASKS[1]] * 2 + [TASKS[2]] * 2)
+        self.assertGreaterEqual(engine.resets, 4)  # setup plus one per sentence
+
+    def test_manual_command_drops_the_list_and_runs_only_that_task(self):
+        robot = Robot(on_observation=lambda reads: reads == 5 and self.commands.lines.put(f"task 30 {TASKS[1]}"))
+        events, engine, robot = self.run_strategy([(TASKS[0], 30.0), (TASKS[2], 30.0)], Detector(ticks=40), robot)
+        ends = [e for e in events if e["event"] == "task_end"]
+        starts = [e for e in events if e["event"] == "task_start"]
+        self.assertEqual([e["reason"] for e in ends], ["preempted", "detector"])
+        self.assertEqual([(e["task"], e["source"], e["total"]) for e in starts],
+                         [(TASKS[0], "list", 2), (TASKS[1], "manual", 1)])
+        self.assertEqual(engine.tasks_seen, [TASKS[0], TASKS[1]])
+        self.assertEqual(events[-1]["reason"], "complete")
+        self.assertIn({joint: 1.0 for joint in JOINTS}, robot.sent)  # returned to the start pose before the manual task
+
+    def test_stop_command_ends_the_session(self):
+        robot = Robot(on_observation=lambda reads: reads == 3 and self.commands.lines.put("stop"))
+        events, engine, _ = self.run_strategy([(task, 30.0) for task in TASKS], Detector(ticks=None), robot)
+        self.assertEqual([e["reason"] for e in events if e["event"] == "task_end"], ["stop"])
+        self.assertEqual(events[-1], {"event": "done", "reason": "stop"})
+
+    def test_limit_with_detector_stops_but_without_detector_moves_on(self):
+        events, _, _ = self.run_strategy([(TASKS[0], 0.05), (TASKS[1], 0.05)], Detector(ticks=None))
+        self.assertEqual([e["reason"] for e in events if e["event"] == "task_end"], ["duration"])
+        self.assertEqual(events[-1]["reason"], "timeout")
+        events, _, _ = self.run_strategy([(TASKS[0], 0.05), (TASKS[1], 0.05)], None)
+        self.assertEqual([e["reason"] for e in events if e["event"] == "task_end"], ["duration", "duration"])
+        self.assertEqual(events[-1]["reason"], "complete")
+
+    def test_closed_stdin_stops_and_bad_commands_are_ignored(self):
+        robot = Robot(on_observation=lambda reads: reads == 3 and [self.commands.lines.put(line) for line in ("task x y", "jump", None)])
+        events, _, _ = self.run_strategy([(TASKS[0], 30.0)], Detector(ticks=None), robot)
+        self.assertEqual(events[-1]["reason"], "stop")
+
+    def test_parse_plan(self):
+        parse = self.module.parse_plan
+        self.assertEqual(parse(json.dumps(TASKS[:2]), "[100, 75.5]"), [(TASKS[0], 100.0), (TASKS[1], 75.5)])
+        for tasks, durations in (("[]", "[]"), ('["a"]', "[1, 2]"), ('["a"]', "[0]"), ('["a"]', "[true]"),
