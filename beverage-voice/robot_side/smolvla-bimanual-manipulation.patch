@@ -0,0 +1,63 @@
+"""home: move both followers to configs/local/home.json, then disconnect. No cameras, no policy.
+
+The pose file holds joint names and values in infer units (degrees, grippers 0-100). The move is the same
+linear interpolation LeRobot uses for return_to_initial_position; it has no collision avoidance.
+"""
+import json
+from pathlib import Path
+import signal
+import sys
+import time
+
+
+def read_pose(path):
+    pose = json.loads(Path(path).read_text(encoding="utf-8"))
+    names, values = pose["joint_names"], pose["home"]
+    if len(names) != len(values) or len(set(names)) != len(names):
+        raise ValueError(f"{path}: joint_names and home must be the same length without duplicates.")
+    return {name: float(value) for name, value in zip(names, values)}
+
+
+def move_to(robot, target, duration_s, fps=50, sleep=time.sleep):
+    start = {key: float(robot.get_observation()[key]) for key in target}
+    steps = max(int(duration_s * fps), 1)
+    for step in range(1, steps + 1):
+        t = step / steps
+        robot.send_action({key: start[key] + (target[key] - start[key]) * t for key in target})  # max_relative_target clips each tick.
+        sleep(1 / fps)
+
+
+def run_home(options, hardware_arguments, pose_path):
+    from dataclasses import dataclass
+
+    import draccus
+    from lerobot.robots import RobotConfig, bi_so_follower, make_robot_from_config  # noqa: F401 registers --robot.type=bi_so_follower
+    from lerobot.utils.robot_utils import precise_sleep
+
+    @dataclass
+    class HomeConfig:
+        robot: RobotConfig
+
+    if not Path(pose_path).is_file():
+        raise FileNotFoundError(f"Create {pose_path} from beverage-voice robot_side/home.example.json after checking calibration.")
+    target = read_pose(pose_path)
+    robot_args = [a for a in hardware_arguments if a.startswith("--robot.")]
+    robot = make_robot_from_config(draccus.parse(config_class=HomeConfig, args=robot_args).robot)
+    joints = [key for key in robot.action_features if key.endswith(".pos")]
+    if set(target) != set(joints):
+        raise ValueError(f"{pose_path} joint names differ from the robot: {sorted(set(target) ^ set(joints))}")
+    duration_s = options.duration_s or 5.0
+    print(f"Home pose: {pose_path}; {len(target)} joints over {duration_s:g}s.", flush=True)
+    if options.validate_only:
+        print("Validated home pose and robot configuration. No hardware connected.", flush=True)
+        return
+    if sys.platform == "win32":  # beverage-voice stops home with CTRL_BREAK; raise KeyboardInterrupt so disconnect still runs.
+        signal.signal(signal.SIGBREAK, signal.default_int_handler)
+    robot.connect(calibrate=False)  # Never start interactive calibration from a remote button.
+    try:
+        if not robot.is_calibrated:
+            raise RuntimeError("Motor calibration differs from the calibration files; calibrate with operation first.")
+        move_to(robot, target, duration_s, sleep=precise_sleep)
+        print("Home pose reached; disconnecting (torque off).", flush=True)
+    finally:
+        robot.disconnect()
